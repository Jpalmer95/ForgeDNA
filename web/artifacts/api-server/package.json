{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx ./src/index.ts",
    "build": "tsx ./build.ts",
    "start": "node dist/index.cjs",
    "db:push": "cd ../../lib/db && pnpm run push",
    "typecheck": "tsc -p tsconfig.json --noEmit"
